        var e = 1 - Math.pow(1 - p, 3); // easeOutCubic
        render(el, el._target * e);
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    statBigs.forEach(function (el) { render(el, 0); }); // start at 0 pre-reveal
    var numObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { statBigs.forEach(spin); }
        else { statBigs.forEach(function (el) { render(el, 0); }); }
      });
    }, { threshold: 0.4 });
    var numbersSec = document.getElementById('numbers');
    if (numbersSec) numObs.observe(numbersSec);
  }
})();
</script>


</body>
</html>
