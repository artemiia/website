    0%   { transform: translate(calc(var(--bx)),        calc(var(--by)));         }
    25%  { transform: translate(calc(var(--bx) + 4px),  calc(var(--by) - 5px)) rotate(-1.5deg); }
    50%  { transform: translate(calc(var(--bx) - 3px),  calc(var(--by) + 4px)) rotate(1deg);    }
    75%  { transform: translate(calc(var(--bx) + 3px),  calc(var(--by) + 5px)) rotate(-1deg);   }
    100% { transform: translate(calc(var(--bx)),        calc(var(--by)));         }
  }
  @media (prefers-reduced-motion: reduce) {
    .appstore-callout .ac-tile { animation: none; transform: none; }
  }
  .appstore-callout:hover .ac-tile { border-color: #33332c; }
  .appstore-callout .ac-tile img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
  }
  /* Telepat's mark is dark monochrome: invert it to read on the dark theme,
     revert on light (mirrors .zoo-logo-mono on the app-store page). */
  .appstore-callout .ac-tile-mono { filter: invert(1); }
  [data-theme="light"] .appstore-callout .ac-tile-mono { filter: none; }
  .appstore-callout .ac-more {
    width: 54px;
    height: 54px;
    flex: none;
