  .path-lead { font-size: 16px; line-height: 1.55; color: var(--ink-dim); margin: 0 0 20px; }
  .path-list { list-style: none; margin: 0 0 24px; padding: 0; display: flex; flex-direction: column; gap: 11px; }
  .path-list li {
